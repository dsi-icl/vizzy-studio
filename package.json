    "scripts": {
        "build": "turbo run build",
        "check": "turbo run quality",
        "docker:build": "node tooling/scripts/docker-build.mjs",
        "docker:test:down": "docker compose -f docker-compose.test.yml down --remove-orphans",
        "docker:test:logs": "docker compose -f docker-compose.test.yml logs -f --tail=200",
        "docker:test:ps": "docker compose -f docker-compose.test.yml ps",
        "docker:test:reset": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
        "docker:test:up": "docker compose -f docker-compose.test.yml up -d --build",
        "deps": "bunx taze@latest -Ilwr --peer",
        "deps:major": "bunx taze@latest major -Ilwr --peer",
        "dev": "turbo run dev",
        "dev:web": "turbo run dev --filter=@repo/web",
        "faviconize": "turbo run faviconize",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "lint": "oxlint --type-aware --type-check",
        "lint:fix": "oxlint --type-aware --type-check --fix",
        "prepare": "husky",
        "test": "bun run test:unit",
        "test:unit": "bun test --conditions=production apps/web/src apps/web/tests/unit packages/db/src",
        "test:e2e": "bunx playwright test --config apps/web/tests/playwright.config.ts",
        "test:e2e:smoke": "bunx playwright test --config apps/web/tests/playwright.config.ts --grep-invert @visual",
        "test:e2e:update": "bunx playwright test --config apps/web/tests/playwright.config.ts --grep @visual --update-snapshots",
        "test:e2e:full": "bun run tooling/testing/e2e-full.mjs",
        "test:harness:down": "bun run docker:test:down",
        "test:harness:prepare": "bun run tooling/testing/prepare.mjs",
        "test:harness:seed": "bun run tooling/testing/seed.mjs",
        "test:harness:up": "bun run docker:test:up",
        "test:integration": "bun test apps/web/tests/integration",
        "test:visual": "bunx playwright test --config apps/web/tests/playwright.config.ts --grep @visual",
        "test:all": "bun run test:unit && bun run test:e2e:full",
        "test:security": "bun run test:harness:prepare && bun run test:integration && bun run test:e2e",
        "ui": "bun run --filter=@repo/ui ui",
        "ui:web": "bun run --filter=@repo/web run ui"
    },
    "devDependencies": {
        "@commitlint/cli": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@realfavicongenerator/generate-favicon": "catalog:",
        "@realfavicongenerator/image-adapter-node": "catalog:",
        "@tanstack/eslint-plugin-query": "catalog:",
        "@tanstack/eslint-plugin-router": "catalog:",
        "eslint-plugin-react-hooks": "catalog:",
        "eslint-plugin-turbo": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "oxlint-tsgolint": "catalog:",
        "turbo": "catalog:"
    },
    "overrides": {
        "babel-plugin-react-compiler": "experimental",
        "bson": "7.2.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "svgdom": "0.1.24",
        "typescript": "^7.0.2",
        "vite": "^8.1.5"
    },
    "lint-staged": {
        "*": "oxfmt --no-error-on-unmatched-pattern"
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "bun@1.3.14"
}
